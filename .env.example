# =============================================================================
# 藝術史資料庫系統環境變數配置
# =============================================================================

# 應用基本配置
NODE_ENV=development
API_PORT=3000
APP_NAME=art-history-database

# =============================================================================
# AI服務API Keys (必填)
# =============================================================================

# OpenAI API Key (必填 - 用於GPT-4處理)
OPENAI_API_KEY=sk-your-openai-api-key-here

# HuggingFace Token (必填 - 用於NLP模型)
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# DeepL API Key (必填 - 用於專業翻譯)
DEEPL_API_KEY=your-deepl-api-key-here

# Google Translate API Key (可選 - 額外翻譯服務)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key-here

# Anthropic Claude API Key (可選 - 備用AI模型)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# 資料庫配置
# =============================================================================

# PostgreSQL 設定
DB_HOST=localhost
DB_PORT=5432
DB_NAME=art_history_db
DB_USER=art_user
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Redis 設定
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch 設定
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=art_history_index

# =============================================================================
# 爬蟲設定
# =============================================================================

# 併發設定
MAX_CONCURRENT_REQUESTS=10
REQUEST_DELAY_MS=1000
RETRY_ATTEMPTS=3
REQUEST_TIMEOUT_MS=30000

# User Agent 設定
USER_AGENT="Art History Database Crawler 1.0"

# =============================================================================
# API限制與安全
# =============================================================================

# API限流
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT設定 (如需認證)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# CORS設定
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# 監控與日誌
# =============================================================================

# 日誌等級 (error, warn, info, debug)
LOG_LEVEL=info

# Grafana管理員密碼
GRAFANA_PASSWORD=your-grafana-admin-password

# Prometheus設定
PROMETHEUS_PORT=9090

# =============================================================================
# 檔案儲存
# =============================================================================

# 資料目錄
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_DIR=./models
LOGS_DIR=./logs

# 上傳限制
MAX_FILE_SIZE_MB=100

# =============================================================================
# Agent特定設定
# =============================================================================

# WebCrawlerAgent
WEB_CRAWLER_ENABLED=true
CRAWLER_SCHEDULE="0 2 * * *"  # 每日凌晨2點執行

# MetadataExtractorAgent
METADATA_CONFIDENCE_THRESHOLD=0.85
DUBLIN_CORE_VALIDATION=true

# ClassificationAgent
CLASSIFICATION_THRESHOLD=0.7
USE_MULTILABEL_CLASSIFICATION=true

# SummarizationTranslationAgent
SUMMARY_MAX_LENGTH=1200
TRANSLATION_BATCH_SIZE=10
ENABLE_CULTURAL_ADAPTATION=true

# =============================================================================
# 第三方服務整合
# =============================================================================

# 博物館API設定
MET_MUSEUM_API_BASE=https://collectionapi.metmuseum.org/public/collection/v1/
LOUVRE_API_BASE=https://www.louvre.fr/api/
BRITISH_MUSEUM_API_BASE=https://www.britishmuseum.org/api/

# 學術資料庫
JSTOR_RSS_URL=https://www.jstor.org/rss/
ACADEMIA_SEARCH_BASE=https://www.academia.edu/search

# =============================================================================
# Docker專用設定
# =============================================================================

# 容器間通信
DB_HOST_DOCKER=postgres
REDIS_HOST_DOCKER=redis
ES_HOST_DOCKER=elasticsearch

# Docker健康檢查
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3